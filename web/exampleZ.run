!##   /    /    / /__/ /_/ / // / _/  / /     ##!
!##  /_/|_/_/|_/____/\____/\___/___/ /_/      ##!
!##                                           ##!
!##                                RUNCARD    ##!
!###############################################!

PROCESS  Z
  collider = pp
  sqrts = 8000
END_PROCESS

RUN example_run_Z_8TeV
  PDF = NNPDF31_nnlo_as_0118[0]
  warmup = 10000[10]
  production = 10000[10]
END_RUN

PARAMETERS
END_PARAMETERS

SELECTORS
  select  mll  min = 66  max = 116
END_SELECTORS

HISTOGRAMS

  yz  min=-2.5  max=+2.5  nbins=5

  yz > yz_90_92  min=-2.5  max=+2.5  nbins=5
  HISTOGRAM_SELECTORS
    select  mll  min = 90  max = 92
  END_HISTOGRAM_SELECTORS

  ptz  min=0  max=30  nbins=10

  ptz > ptz_cumulant  min=0  max=30  nbins=10  cumulant=+1

  etz  min=80  max=150  nbins=7
  mll  min=80  max=100  nbins=10

  COMPOSITE > ptlpm [0,10,20,40,60,100,150,200]
    ptlp
    ptlm
  END_COMPOSITE

END_HISTOGRAMS


SCALES
  mur = 1   * mll  muf = 1   * mll
  mur = 2   * mll  muf = 2   * mll
  mur = 0.5 * mll  muf = 0.5 * mll
  mur = 2   * mll  muf = 1   * mll
  mur = 1   * mll  muf = 2   * mll
  mur = 0.5 * mll  muf = 1   * mll
  mur = 1   * mll  muf = 0.5 * mll
END_SCALES

CHANNELS
  LO
END_CHANNELS
