!###############################################!

! Higgs-boson production in gluon fusion (HEFT) with decay to l+ l- photon
! (through H -> Z gamma) at the 13 TeV LHC. Same fiducial cuts as
! HTO2L1PJ/nnlojet-2111.02157-HTO2l1pJ13TeV.run, without the cut on pth.

PROCESS  Hto2l1p
  collider = pp  sqrts = 13000.0
  jet = antikt[0.4]  jet_exclusive = .false.  jet_recomb = V4
  decay_type = 2
END_PROCESS

RUN  Hto2l1p13TeV
  PDF = PDF4LHC21_40[0]
  tcut = 1d-8
  iseed      = 1
  warmup     = 20000[5]
  production = 100000[10]
END_RUN

PARAMETERS
  MASS[H]  = 125
  WIDTH[H] = 0.0041
END_PARAMETERS

SELECTORS
  select m23         min = 81.2  max = 101.2
  select min_dr_lp   min = 0.3
  select ptgamma     min = 15
  select abs_ygamma  max = 2.37
  select ptl1st      min = 10
  select ptl2nd      min = 10
  select abs_yl1st   max = 2.7
  select abs_yl2nd   max = 2.7

  ! jet definition (only used for the njets distribution)
  select jets_pt     min = 30
  select jets_abs_y  max = 4.4
END_SELECTORS

HISTOGRAMS
  pth      > pth      nbins = 40  min = 0   max = 400
  yh       > yh       nbins = 24  min = -3  max = 3
  ptgamma  > ptgamma  nbins = 20  min = 0   max = 200
  m23      > m23      nbins = 38  min = 82  max = 101
  njets    > njets    nbins = 4   min = -0.5  max = 3.5
END_HISTOGRAMS

SCALES
  muf = 0.5 * eth     mur = 0.5 * eth
  muf = 1 * eth     mur = 1 * eth
  muf = 0.25 * eth     mur = 0.25 * eth
  muf = 0.5 * eth     mur = 1 * eth
  muf = 1 * eth     mur = 0.5 * eth
  muf = 0.5 * eth     mur = 0.25 * eth
  muf = 0.25 * eth     mur = 0.5 * eth
END_SCALES

CHANNELS
  ! Contributions to compute (one or more per line):
  !   LO           Born
  !   R  V         NLO real and virtual corrections
  !   RR  RV  VV   NNLO double-real, real-virtual, double-virtual corrections
  ! (RRa/RRb restrict the double-real to one of its two phase-space regions)
  LO
END_CHANNELS
