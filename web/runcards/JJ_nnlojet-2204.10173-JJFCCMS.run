END_HISTOGRAMS

SCALES

    muf =  1.0 * ht_part     mur =  1.0 * ht_part
    muf =  2.0 * ht_part     mur =  2.0 * ht_part
    muf =  0.5 * ht_part     mur =  0.5 * ht_part 
    muf =  1.0 * ht_part     mur =  0.5 * ht_part
    muf =  0.5 * ht_part     mur =  1.0 * ht_part
    muf =  1.0 * ht_part     mur =  2.0 * ht_part
    muf =  2.0 * ht_part     mur =  1.0 * ht_part

END_SCALES

REWEIGHT ht_part**6.5

CHANNELS

  RRa

END_CHANNELS




