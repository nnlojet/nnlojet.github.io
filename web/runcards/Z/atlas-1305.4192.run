
!###############################################!
!##                                           ##!
!##     _  ___  ____   ____     ____________  ##!
!##    / |/ / |/ / /  / __ \__ / / __/_  __/  ##!
!##   /    /    / /__/ /_/ / // / _/  / /     ##!
!##  /_/|_/_/|_/____/\____/\___/___/ /_/      ##!
!##                                           ##!
!###############################################!

PROCESS  Z
  collider = PP  sqrts = 7000.0
  jet = none
END_PROCESS

RUN  ATLAS_Z0_7TEV_49FB_HIMASS
  PDF = NNPDF40_nnlo_as_01180[0]
  tcut = 1e-07
  iseed = 1
  warmup = 20000[7]
  production = 100000[10]
END_RUN

PARAMETERS
  MASS[Z] = 91.1876
  WIDTH[Z] = 2.4955
  MASS[W] = 80.377
  WIDTH[W] = 2.085
  CKM = FULL
  SCHEME[ALPHA] = GMU
  SCHEME[GV] = CMS
  GF = 1.1663787e-05
END_PARAMETERS

SELECTORS
  select abs_yz  min = 0.0 max = 2.5
  select abs_ylp  min = 0.0 max = 2.5
  select abs_ylm  min = 0.0 max = 2.5
  select ptlp  min = 25.0
  select ptlm  min = 25.0
  select mll  min = 116.0 max = 1500.0
END_SELECTORS

HISTOGRAMS
  mll > M [116.0, 130.0, 150.0, 170.0, 190.0, 210.0, 230.0, 250.0, 300.0, 400.0, 500.0, 700.0, 1000.0, 1500.0]
END_HISTOGRAMS

SCALES
  mur = etz  muf = etz
END_SCALES

CHANNELS
  ! Contributions to compute (one or more per line):
  !   LO           Born
  !   R  V         NLO real and virtual corrections
  !   RR  RV  VV   NNLO double-real, real-virtual, double-virtual corrections
  ! (RRa/RRb restrict the double-real to one of its two phase-space regions)
  LO
END_CHANNELS


