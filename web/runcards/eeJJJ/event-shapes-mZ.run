
!###############################################!
!##                                           ##!
!##     _  ___  ____   ____     ____________  ##!
!##    / |/ / |/ / /  / __ \__ / / __/_  __/  ##!
!##   /    /    / /__/ /_/ / // / _/  / /     ##!
!##  /_/|_/_/|_/____/\____/\___/___/ /_/      ##!
!##                                           ##!
!###############################################!

! Event shapes in e+e- annihilation at the Z pole (LEP1).
! The jet algorithm is not used to define the events (jade[0] does not
! cluster any partons): instead, `select njets min = 0` lifts the default
! requirement of three jets and the OR group requires at least one of the
! event shapes to be above a small cutoff, which keeps the calculation
! infrared safe.
! The JADE transition rate y23 is binned logarithmically (binning = LOG), and
! the thrust distribution is also given as a cumulant (cumulant = -1),
! i.e. the cross section with 1-T below the upper edge of each bin.

PROCESS  eeJJJ
  collider = EPEM  sqrts = 91.1876
  jet = jade[0]
END_PROCESS

RUN  eeJJJshapes
  PDF = NNPDF31_nnlo_as_0118[0]   ! only used for the running of alpha_s
  iseed      = 1
  warmup     = 20000[5]
  production = 100000[10]
END_RUN

PARAMETERS
END_PARAMETERS

SELECTORS
  select njets min = 0
  OR
    select 1mT min = 0.001
    select C   min = 0.001
    select HJM min = 0.001
    select WJB min = 0.001
    select TJB min = 0.001
  END_OR
END_SELECTORS

HISTOGRAMS
  1mT                 nbins = 25  min = 0     max = 0.5
  1mT > 1mT_cumulant  nbins = 25  min = 0     max = 0.5  cumulant = -1
  C                   nbins = 50  min = 0     max = 1
  HJM                 nbins = 25  min = 0     max = 0.5
  TJB                 nbins = 25  min = 0     max = 0.5
  WJB                 nbins = 25  min = 0     max = 0.5
  y23 > y23_log       nbins = 20  min = 1d-4  max = 1    binning = LOG
END_HISTOGRAMS

SCALES
  muf = 91.1876     mur = 91.1876
  muf = 91.1876     mur = 45.5938
  muf = 91.1876     mur = 182.3752
END_SCALES

CHANNELS
  ! Contributions to compute (one or more per line):
  !   LO           Born
  !   R  V         NLO real and virtual corrections
  !   RR  RV  VV   NNLO double-real, real-virtual, double-virtual corrections
  ! (RRa/RRb restrict the double-real to one of its two phase-space regions)
  LO
END_CHANNELS
