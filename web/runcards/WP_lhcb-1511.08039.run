PROCESS  WP
  collider = pp  sqrts = 8000.0
  jet = none[0]
END_PROCESS

RUN  LHCB_WP_8TEV_MUON_Y
  PDF = NNPDF40_nnlo_as_01180[0]
  tcut = 1e-07
  iseed = 1
  warmup = 20000[7]
  production = 100000[10]
END_RUN

PARAMETERS
  MASS[Z] = 91.1876
  WIDTH[Z] = 2.4955
  MASS[W] = 80.377
  WIDTH[W] = 2.085
  CKM = FULL
  SCHEME[ALPHA] = GF
  SCHEME[WIDTH_V] = CMS
  GF = 1.1663787e-05
END_PARAMETERS

SELECTORS
  select ylp  min = 2.0 max = 4.5
  select ptlp  min = 20.0
END_SELECTORS

HISTOGRAMS
  ylp > y [2.0, 2.25, 2.5, 2.75, 3.0, 3.25, 3.5, 4.0, 4.5]
END_HISTOGRAMS

SCALES
  mur = etw  muf = etw
END_SCALES

CHANNELS 
  LO
END_CHANNELS


