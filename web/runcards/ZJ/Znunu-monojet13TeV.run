!##     _  ___  ____   ____     ____________  ##!
!##    / |/ / |/ / /  / __ \__ / / __/_  __/  ##!
!##   /    /    / /__/ /_/ / // / _/  / /     ##!
!##  /_/|_/_/|_/____/\____/\___/___/ /_/      ##!
!##                                           ##!
!###############################################!

! Z boson decaying to neutrinos in association with jets ("monojet" signature)
! at the 13 TeV LHC, with illustrative cuts on the missing transverse
! momentum and the jets. With L_NC = NU the Z boson decays invisibly
! (one neutrino family), such that its transverse momentum ptz is the
! missing transverse momentum.
! The card also illustrates some optional features:
!  - an automatic warmup schedule (warmup = <ncall>[auto]);
!  - a selector that only applies if the observable is valid
!    (select_if_valid: the angle to the second jet only exists if there is
!    a second jet);
!  - a cumulant histogram (cumulant = +1: cross section above each bin edge);
!  - a histogram broken down into partonic luminosities (output_type = 1);
!  - a fiducial cross section with additional histogram selectors.

PROCESS  ZJ
  collider = PP  sqrts = 13000.0
  jet = antikt[0.4]  jet_exclusive = .false.  jet_recomb = V4
  L_NC = NU     ! Z -> neutrino pair
END_PROCESS

RUN  ZnunuJ13TeV
  PDF = NNPDF31_nnlo_as_0118[0]
  iseed      = 1
  warmup     = 50000[auto]
  production = 100000[10]
END_RUN

PARAMETERS
  MASS[Z]  = 91.1876
  WIDTH[Z] = 2.4952
  MASS[W]  = 80.385
  WIDTH[W] = 2.085
  SCHEME[ALPHA] = GMU
  GF = 1.1663787d-5
END_PARAMETERS

SELECTORS
  select ptz          min = 200   ! missing transverse momentum
  select jets_pt      min = 30
  select jets_abs_y   max = 2.4
  select ptj1         min = 100
  select dphi_Zj1     min = 0.4
  select_if_valid dphi_Zj2  min = 0.4
END_SELECTORS

HISTOGRAMS
  ptz > met            [200, 250, 300, 350, 400, 500, 600, 700, 800, 1000, 1400]
  ptz > met_cumulant   [200, 300, 400, 500, 700, 1000, 1400]  cumulant = +1
  ptj1                 [100, 200, 300, 400, 600, 1000]        output_type = 1
  njets                nbins = 4  min = 0.5  max = 4.5
  cross > xs_met500
  HISTOGRAM_SELECTORS
    select ptz min = 500
  END_HISTOGRAM_SELECTORS
END_HISTOGRAMS

SCALES
  muf = 0.5 * ht_full     mur = 0.5 * ht_full
  muf = 0.25 * ht_full    mur = 0.25 * ht_full
  muf = 1.0 * ht_full     mur = 1.0 * ht_full
  muf = 0.5 * ht_full     mur = 0.25 * ht_full
  muf = 0.5 * ht_full     mur = 1.0 * ht_full
  muf = 0.25 * ht_full    mur = 0.5 * ht_full
  muf = 1.0 * ht_full     mur = 0.5 * ht_full
END_SCALES

CHANNELS
  ! Contributions to compute (one or more per line):
  !   LO           Born
  !   R  V         NLO real and virtual corrections
  !   RR  RV  VV   NNLO double-real, real-virtual, double-virtual corrections
  ! (RRa/RRb restrict the double-real to one of its two phase-space regions)
  LO
END_CHANNELS
