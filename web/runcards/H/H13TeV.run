!##     _  ___  ____   ____     ____________  ##!
!##    / |/ / |/ / /  / __ \__ / / __/_  __/  ##!
!##   /    /    / /__/ /_/ / // / _/  / /     ##!
!##  /_/|_/_/|_/____/\____/\___/___/ /_/      ##!
!##                                           ##!
!###############################################!

! Inclusive Higgs-boson production in gluon fusion (HEFT, mt -> infinity)
! at the 13 TeV LHC. The Higgs boson is treated as a stable particle.
! Note: pth and njets are trivial at LO and become non-trivial from NLO on.

PROCESS  H
  collider = pp  sqrts = 13000.0
  jet = antikt[0.4]  jet_exclusive = .false.  jet_recomb = V4
  decay_type = 3
END_PROCESS

RUN  H13TeV
  PDF = PDF4LHC21_40[0]
  tcut = 1d-8
  iseed      = 1
  warmup     = 20000[5]
  production = 100000[10]
END_RUN

PARAMETERS
  MASS[H]  = 125
  WIDTH[H] = 0.0041
END_PARAMETERS

SELECTORS
  select jets_pt     min = 30
  select jets_abs_y  max = 4.4
END_SELECTORS

HISTOGRAMS
  abs_yh > abs_yh   [0, 0.15, 0.3, 0.6, 0.9, 1.2, 1.6, 2.0, 2.5, 3.5]
  pth    > pth      [0, 10, 20, 30, 45, 60, 80, 120, 200, 350]
  njets  > njets    nbins = 4  min = -0.5  max = 3.5
END_HISTOGRAMS

SCALES
  muf = 0.5 * 125     mur = 0.5 * 125
  muf = 1 * 125     mur = 1 * 125
  muf = 0.25 * 125     mur = 0.25 * 125
  muf = 0.5 * 125     mur = 1 * 125
  muf = 1 * 125     mur = 0.5 * 125
  muf = 0.5 * 125     mur = 0.25 * 125
  muf = 0.25 * 125     mur = 0.5 * 125
END_SCALES

CHANNELS
  ! Contributions to compute (one or more per line):
  !   LO           Born
  !   R  V         NLO real and virtual corrections
  !   RR  RV  VV   NNLO double-real, real-virtual, double-virtual corrections
  ! (RRa/RRb restrict the double-real to one of its two phase-space regions)
  LO
END_CHANNELS
