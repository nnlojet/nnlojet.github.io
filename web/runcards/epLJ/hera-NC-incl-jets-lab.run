!###############################################!

! Neutral-current deep-inelastic scattering (e- p) with at least one jet
! in the laboratory frame at HERA (Ee = 27.6 GeV, Ep = 920 GeV), with
! H1-like cuts on Q2, inelasticity y and the jet kinematics.
! At LO the jet is the struck quark.
! Z-boson exchange is included (V_NC = ZGAMMA; the default for neutral-current
! DIS is photon exchange only) and the electron beam is longitudinally
! polarised (pol = -0.3, as at HERA II). The polarisation only affects the
! Z-exchange contributions.

PROCESS  epLJ
  collider = PE  Ebeam1 = 920  Ebeam2 = 27.6
  jet = kt[1]  jet_exclusive = .false.  jet_recomb = V4
  dis_frame = LAB     ! jets are reconstructed in the laboratory frame (default for epLJ)
  V_NC      = ZGAMMA  ! photon and Z-boson exchange
  pol       = -0.3    ! polarisation of the lepton beam: -1 (+1) purely left- (right-)handed
END_PROCESS

RUN  NCjetsLab
  PDF = NNPDF40_nnlo_as_01180[0]
  iseed      = 1
  warmup     = 20000[5]
  production = 100000[10]
END_RUN

PARAMETERS
  SCHEME[ALPHA] = ALPHA0
END_PARAMETERS

SELECTORS
  select q2        min = 150
  select y         min = 0.2  max = 0.7
  select jets_pt   min = 10
  select jets_eta  min = -1   max = 2.5
  select njets     min = 1
END_SELECTORS

HISTOGRAMS
  q2     > q2      [150, 200, 270, 400, 700, 1500, 5000, 15000]
  ptj1   > ptj1    [10, 14, 18, 25, 35, 50, 100]
  etaj1  > etaj1   nbins = 14  min = -1  max = 2.5
END_HISTOGRAMS

SCALES
  muf = 1 * q     mur = 1 * q
  muf = 2 * q     mur = 2 * q
  muf = 0.5 * q     mur = 0.5 * q
  muf = 1 * q     mur = 2 * q
  muf = 2 * q     mur = 1 * q
  muf = 1 * q     mur = 0.5 * q
  muf = 0.5 * q     mur = 1 * q
END_SCALES

CHANNELS
  ! Contributions to compute (one or more per line):
  !   LO           Born
  !   R  V         NLO real and virtual corrections
  !   RR  RV  VV   NNLO double-real, real-virtual, double-virtual corrections
  ! (RRa/RRb restrict the double-real to one of its two phase-space regions)
  LO
END_CHANNELS
