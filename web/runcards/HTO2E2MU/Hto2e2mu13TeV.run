!###############################################!

! Higgs-boson production in gluon fusion (HEFT) with decay to two electrons
! and two muons (H -> Z Z* -> e+ e- mu+ mu-) at the 13 TeV LHC. Same lepton
! cuts as HTO2E2MUJ/nnlojet-1905.13738-Hto2e2muJ13TeV.run (ATLAS-like
! fiducial region), without jet requirement.

PROCESS  Hto2e2mu
  collider = pp  sqrts = 13000.0
  jet = antikt[0.4]  jet_exclusive = .false.  jet_recomb = V4
  decay_type = 2
END_PROCESS

RUN  Hto2e2mu13TeV
  PDF = PDF4LHC21_40[0]
  tcut = 1d-8
  iseed      = 1
  warmup     = 20000[5]
  production = 100000[10]
END_RUN

PARAMETERS
  MASS[H]  = 125
  WIDTH[H] = 0.0041
END_PARAMETERS

SELECTORS
  select ptmum      min = 5
  select abs_ymum   max = 2.7
  select ptmup      min = 5
  select abs_ymup   max = 2.7
  select ptem       min = 7
  select abs_yem    max = 2.47
  select ptep       min = 7
  select abs_yep    max = 2.47
  select ptl1st     min = 20
  select ptl2nd     min = 15
  select ptl3rd     min = 10
  select m2lnearmZ  min = 50  max = 106
  select m2lfarmZ   min = 12  max = 115
  select min_dr_sf  min = 0.1
  select min_dr_df  min = 0.2

  ! jet definition (only used for the njets distribution)
  select jets_pt     min = 30
  select jets_abs_y  max = 4.4
END_SELECTORS

HISTOGRAMS
  pth      > pth      [0, 10, 20, 30, 45, 60, 80, 120, 200, 350]
  abs_yh   > abs_yh   [0, 0.15, 0.3, 0.6, 0.9, 1.2, 1.6, 2.0, 2.5]
  ptl1st   > ptl1st   nbins = 25  min = 0  max = 250
  mepem    > mepem    nbins = 30  min = 0  max = 120
  mmupmum  > mmupmum  nbins = 30  min = 0  max = 120
  njets    > njets    nbins = 4   min = -0.5  max = 3.5
END_HISTOGRAMS

SCALES
  muf = 0.5 * eth     mur = 0.5 * eth
  muf = 1 * eth     mur = 1 * eth
  muf = 0.25 * eth     mur = 0.25 * eth
  muf = 0.5 * eth     mur = 1 * eth
  muf = 1 * eth     mur = 0.5 * eth
  muf = 0.5 * eth     mur = 0.25 * eth
  muf = 0.25 * eth     mur = 0.5 * eth
END_SCALES

CHANNELS
  ! Contributions to compute (one or more per line):
  !   LO           Born
  !   R  V         NLO real and virtual corrections
  !   RR  RV  VV   NNLO double-real, real-virtual, double-virtual corrections
  ! (RRa/RRb restrict the double-real to one of its two phase-space regions)
  LO
END_CHANNELS
