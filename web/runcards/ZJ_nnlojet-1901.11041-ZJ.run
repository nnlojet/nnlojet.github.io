
PROCESS  ZJ

  collider = pp
  sqrts = 7000.0
  jet = antikt[0.4]
  jet_exclusive = .false. 
  jet_recomb = V4
  decay_type = 1

END_PROCESS

RUN  LO
  PDF = NNPDF31_nnlo_as_0118[0]
  tcut = 1d-8
  iseed   = 1
  warmup = 50000[10]
  production = 100000[10]
END_RUN

PARAMETERS
  MASS[Z] = 91.1876
  WIDTH[Z] = 2.4952
  MASS[W] = 80.385
  WIDTH[W] = 2.085
  SCHEME[alpha] = Gmu
  GF = 1.1663787d-5
END_PARAMETERS

SELECTORS
  select jets_pt        min = 30
  select min_dr_lj      min = 0.5
  select jets_abs_y     max = 4.4
  select abs_ylm        max = 2.5
  select abs_ylp        max = 2.5
  select ptlm           min = 20
  select ptlp           min = 20
  select dr_l12         min = 0.2
  select njets          min = 1
  select mll            min = 66   max = 116
END_SELECTORS


HISTOGRAMS
  njets > njets_a  [-0.5,0.5,1.5,2.5,3.5]
  HISTOGRAM_SELECTORS
    select mll max=116
  END_HISTOGRAM_SELECTORS

  njets > njets_b  [-0.5,0.5,1.5,2.5,3.5]
  HISTOGRAM_SELECTORS
    select mll max=116
    select ptlp min=25
    select ptlm min=25
  END_HISTOGRAM_SELECTORS

  njets > njets_c  [-0.5,0.5,1.5,2.5,3.5]

  njets > njets_d  [-0.5,0.5,1.5,2.5,3.5]
  HISTOGRAM_SELECTORS
    select ptlp min=25
    select ptlm min=25
  END_HISTOGRAM_SELECTORS


