!###############################################!
!##                                           ##!
!##     _  ___  ____   ____     ____________  ##!
!##    / |/ / |/ / /  / __ \__ / / __/_  __/  ##!
!##   /    /    / /__/ /_/ / // / _/  / /     ##!
!##  /_/|_/_/|_/____/\____/\___/___/ /_/      ##!
!##                                           ##!
!##                                RUNCARD    ##!
!###############################################!


PROCESS  epLJJ
  collider = ep    Ebeam1 = 27.5  Ebeam2 = 920
  jet = kt[1]  jet_exclusive = .false.  jet_recomb = Et
END_PROCESS


RUN  ZEUS2j
  PDF = NNPDF30_nnlo_as_0118[0]
  iseed   = -1
  imethod = 2
  angular_average    = .true.
  multi_channel      = 5
  scale_coefficients = .false.
END_RUN


PARAMETERS
  SCHEME[ALPHA] = ALPHA0
END_PARAMETERS

SELECTORS

  ! --- Dijets:  1010.6167 [hep-ex]
  select q2            min = 125  max = 20000
  select y             min = 0.2  max = 0.6
  select jets_hera_eta min = -1   max = 2.5
  select jets_et       min = 8
  select njets         min = 2
  select m12           min = 20

END_SELECTORS


HISTOGRAMS

  ptavg_12 > ptavg_12_debug  [0,1,2,4,8,16,32,64,128,256,512,1024,2048]
  m12      > m12_debug       [0,1,2,4,8,16,32,64,128,256,512,1024,2048]

  ! ------------------------------------------------------------------------------- !
  !    Fig. 8 (left) [1703.05977] --- ZEUS di-jets Q2
  ! ------------------------------------------------------------------------------- !
  q2 [125,250,500,1000,2000,5000,20000]  output_type = 0

  ! ------------------------------------------------------------------------------- !
  !    Fig. 8 (right) [1703.05977] --- ZEUS di-jets x-Bj
  ! ------------------------------------------------------------------------------- !
  x [0.0001,0.01,0.02,0.035,0.07,0.1]  output_type = 0

  ! ------------------------------------------------------------------------------- !
  !    Fig. 9 (left) [1703.05977] --- ZEUS di-jets Mjj
  ! ------------------------------------------------------------------------------- !
  m12 [20,30,45,65,120]  output_type = 0

  ! ------------------------------------------------------------------------------- !
  !    Fig. 9 (right) [1703.05977] --- ZEUS di-jets ptavg_12
  ! ------------------------------------------------------------------------------- !
  ptavg_12 [8,15,22,30,60]  output_type = 0

  ! ------------------------------------------------------------------------------- !
  !    Fig. 10 [1703.05977] --- ZEUS di-jets ptavg_12 & Q2
  ! ------------------------------------------------------------------------------- !
  ptavg_12 > ptavg_12_q2_125_250 [8,15,22,30,60]  output_type = 0
    HISTOGRAM_SELECTORS
      select  q2     min = 125  max = 250
    END_HISTOGRAM_SELECTORS
  ptavg_12 > ptavg_12_q2_250_500 [8,15,22,30,60]  output_type = 0
    HISTOGRAM_SELECTORS
      select  q2     min = 250  max = 500
    END_HISTOGRAM_SELECTORS
  ptavg_12 > ptavg_12_q2_500_1000 [8,15,22,30,60]  output_type = 0
    HISTOGRAM_SELECTORS
      select  q2     min = 500  max = 1000
    END_HISTOGRAM_SELECTORS
  ptavg_12 > ptavg_12_q2_1000_2000 [8,15,22,30,60]  output_type = 0
    HISTOGRAM_SELECTORS
      select  q2     min = 1000  max = 2000
    END_HISTOGRAM_SELECTORS
  ptavg_12 > ptavg_12_q2_2000_5000 [8,16,28,60]  output_type = 0
    HISTOGRAM_SELECTORS
      select  q2     min = 2000  max = 5000
    END_HISTOGRAM_SELECTORS
  ptavg_12 > ptavg_12_q2_5000_20000 [8,16,28,60]  output_type = 0
    HISTOGRAM_SELECTORS
      select  q2     min = 5000  max = 20000
    END_HISTOGRAM_SELECTORS

  ! ------------------------------------------------------------------------------- !
  !    Fig. 11 (left) [1703.05977] --- ZEUS di-jets eta*
  ! ------------------------------------------------------------------------------- !
  etas [0,0.2,0.4,0.65,0.95,2]  output_type = 0

  ! ------------------------------------------------------------------------------- !
  !    Fig. 11 (right) [1703.05977] --- ZEUS di-jets log(xi2)
  ! ------------------------------------------------------------------------------- !
  lgxi2 [-2,-1.6,-1.45,-1.3,-1.1,0]  output_type = 0

  ! ------------------------------------------------------------------------------- !
  !    Fig. 12 [1703.05977] --- ZEUS di-jets lgxi2 & Q2
  ! ------------------------------------------------------------------------------- !
  lgxi2 > lgxi2_q2_125_250 [-2.1,-1.65,-1.5,-1.3,-0.4]  output_type = 0
    HISTOGRAM_SELECTORS
      select  q2     min = 125  max = 250
    END_HISTOGRAM_SELECTORS
  lgxi2 > lgxi2_q2_250_500 [-2,-1.55,-1.4,-1.25,-0.4]  output_type = 0
    HISTOGRAM_SELECTORS
      select  q2     min = 250  max = 500
    END_HISTOGRAM_SELECTORS
  lgxi2 > lgxi2_q2_500_1000 [-1.9,-1.45,-1.3,-1.15,-0.4]  output_type = 0
    HISTOGRAM_SELECTORS
      select  q2     min = 500  max = 1000
    END_HISTOGRAM_SELECTORS
  lgxi2 > lgxi2_q2_1000_2000 [-1.7,-1.25,-1.15,-1,-0.25]  output_type = 0
    HISTOGRAM_SELECTORS
      select  q2     min = 1000  max = 2000
    END_HISTOGRAM_SELECTORS
  lgxi2 > lgxi2_q2_2000_5000 [-1.5,-1,-0.85,-0.2]  output_type = 0
    HISTOGRAM_SELECTORS
      select  q2     min = 2000  max = 5000
    END_HISTOGRAM_SELECTORS
  lgxi2 > lgxi2_q2_5000_20000 [-1.1,-0.75,-0.55,0]  output_type = 0
    HISTOGRAM_SELECTORS
      select  q2     min = 5000  max = 20000
    END_HISTOGRAM_SELECTORS

END_HISTOGRAMS


CHANNELS
END_CHANNELS


REWEIGHT  ht_part


PDF_INTERPOLATION


SCALES

  mur = 1.0 * dscl   muf = 1.0 * dscl
  mur = 0.5 * dscl   muf = 0.5 * dscl
  mur = 2.0 * dscl   muf = 2.0 * dscl

  mur = 1.0 * dscl   muf = 0.5 * dscl
  mur = 1.0 * dscl   muf = 2.0 * dscl

  mur = 0.5 * dscl   muf = 1.0 * dscl
  mur = 2.0 * dscl   muf = 1.0 * dscl

END_SCALES

