
!###############################################!
!##                                           ##!
!##     _  ___  ____   ____     ____________  ##!
!##    / |/ / |/ / /  / __ \__ / / __/_  __/  ##!
!##   /    /    / /__/ /_/ / // / _/  / /     ##!
!##  /_/|_/_/|_/____/\____/\___/___/ /_/      ##!
!##                                           ##!
!###############################################!

PROCESS  WM
  collider = PP  sqrts = 8000.0
  jet = none
END_PROCESS

RUN  LHCB_WM_8TEV_MUON_Y
  PDF = NNPDF40_nnlo_as_01180[0]
  tcut = 1e-07
  iseed = 1
  warmup = 20000[7]
  production = 100000[10]
END_RUN

PARAMETERS
  MASS[Z] = 91.1876
  WIDTH[Z] = 2.4955
  MASS[W] = 80.377
  WIDTH[W] = 2.085
  CKM = FULL
  SCHEME[ALPHA] = GMU
  SCHEME[GV] = CMS
  GF = 1.1663787e-05
END_PARAMETERS

SELECTORS
  select ylm  min = 2.0 max = 4.5
  select ptlm  min = 20.0
END_SELECTORS

HISTOGRAMS
  ylm > y [2.0, 2.25, 2.5, 2.75, 3.0, 3.25, 3.5, 4.0, 4.5]
END_HISTOGRAMS

SCALES
  mur = etw  muf = etw
END_SCALES

CHANNELS
  ! Contributions to compute (one or more per line):
  !   LO           Born
  !   R  V         NLO real and virtual corrections
  !   RR  RV  VV   NNLO double-real, real-virtual, double-virtual corrections
  ! (RRa/RRb restrict the double-real to one of its two phase-space regions)
  LO
END_CHANNELS


