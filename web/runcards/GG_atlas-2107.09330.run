PROCESS  GG
  collider = LHC
  sqrts = 13000.0
  photon_isolation = frix[R=0.1, ETmax_epsilon=0.15, n=1] + etsum[R=0.2, ETmax_epsilon=0.09]
  decay_type = 0
END_PROCESS

RUN  ATLAS_GG 
  PDF = NNPDF30_nnlo_as_0118[0]
  tcut = 1d-9
  reset_vegas_grid = .true.
  angular_average  = .false.
  multi_channel    = .false.
  lips_reduce      = .true.
  warmup = 10000[10]
  production = 10000[10]
END_RUN

PARAMETERS
  SCHEME[GV]  = CMS
  SCHEME[alpha] = Gmu 
  hard_photon_alpha0 = .true.
END_PARAMETERS

SELECTORS
    select dr_g1g2 min = 0.4 ! Angular separations for photons
    select ptg1 min = 40
    select ptg2 min = 30 ! Leading- and sub-leading-pt cuts for gammas.
    select photons_abs_y max = 2.37 
    reject photons_abs_y min = 1.37 max = 1.52 ! The upper bound for nontrivial cut
END_SELECTORS

