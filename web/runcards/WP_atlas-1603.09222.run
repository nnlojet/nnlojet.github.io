!###############################################!

PROCESS  WP
  collider = pp  sqrts = 13000.0
  jet = none[0]
END_PROCESS

RUN  ATLAS_WP_13TEV_TOT
  PDF = NNPDF40_nnlo_as_01180[0]
  tcut = 1e-07
  iseed = 1
  warmup = 20000[7]
  production = 100000[10]
END_RUN

PARAMETERS
  MASS[Z] = 91.1876
  WIDTH[Z] = 2.4955
  MASS[W] = 80.377
  WIDTH[W] = 2.085
  CKM = FULL
  SCHEME[ALPHA] = GF
  SCHEME[WIDTH_V] = CMS
  GF = 1.1663787e-05
END_PARAMETERS

SELECTORS
  select abs_ylp  min = 0.0 max = 2.5
  select ptlp  min = 25.0
  select etmiss  min = 25.0
  select mt  min = 50.0
END_SELECTORS

HISTOGRAMS
  ylp > tot [-4.9, 4.9]
END_HISTOGRAMS

SCALES
  mur = etw  muf = etw
END_SCALES

CHANNELS 
  LO
END_CHANNELS


