PROCESS  Z
  collider = pp  sqrts = 7000.0
  jet = none[0]
END_PROCESS

RUN  ATLAS_Z0_7TEV_46FB_CF-Y
  PDF = NNPDF40_nnlo_as_01180[0]
  tcut = 1e-07
  iseed = 1
  warmup = 20000[7]
  production = 100000[10]
END_RUN

PARAMETERS
  MASS[Z] = 91.1876
  WIDTH[Z] = 2.4955
  MASS[W] = 80.377
  WIDTH[W] = 2.085
  CKM = FULL
  SCHEME[ALPHA] = GF
  SCHEME[WIDTH_V] = CMS
  GF = 1.1663787e-05
END_PARAMETERS

SELECTORS
  select abs_ylp  max = 4.9
  select abs_ylm  max = 4.9
  select ptlp  min = 20.0
  select ptlm  min = 20.0
  select mll  min = 66.0 max = 150.0
END_SELECTORS

HISTOGRAMS
  COMPOSITE > etay_bin_0 [1.2, 1.4, 1.6, 1.8, 2.0, 2.2, 2.4, 2.8, 3.2, 3.6]
  HISTOGRAM_SELECTORS
      select mll  min = 66.0 max = 116.0
  END_HISTOGRAM_SELECTORS
    abs_yz
    HISTOGRAM_SELECTORS
        select abs_ylp  min = 2.5
        select abs_ylm  max = 2.5
    END_HISTOGRAM_SELECTORS
    abs_yz
    HISTOGRAM_SELECTORS
        select abs_ylp  max = 2.5
        select abs_ylm  min = 2.5
    END_HISTOGRAM_SELECTORS
  END_COMPOSITE

  COMPOSITE > etay_bin_1 [1.2, 1.6, 2.0, 2.4, 2.8, 3.2, 3.6]
  HISTOGRAM_SELECTORS
      select mll  min = 116.0 max = 150.0
  END_HISTOGRAM_SELECTORS
    abs_yz
    HISTOGRAM_SELECTORS
        select abs_ylp  min = 2.5
        select abs_ylm  max = 2.5
    END_HISTOGRAM_SELECTORS
    abs_yz
    HISTOGRAM_SELECTORS
        select abs_ylp  max = 2.5
        select abs_ylm  min = 2.5
    END_HISTOGRAM_SELECTORS
  END_COMPOSITE

END_HISTOGRAMS

SCALES
  mur = etz  muf = etz
END_SCALES

CHANNELS 
  LO
END_CHANNELS


