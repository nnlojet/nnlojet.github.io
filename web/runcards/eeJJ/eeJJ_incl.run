PROCESS eeJJ
  collider = epem
  sqrts = 91.2
  jet = jade[0.01]
  V_NC = GAMMA
END_PROCESS

RUN EEJJINCL
  PDF = NNPDF31_nnlo_as_0118
  iseed      = 1
  warmup     = 20000[5]
  production = 100000[10]
END_RUN

PARAMETERS
  SCHEME[ALPHA] = FIXED
  ALPHA = 0.007818608287724784
  WIDTH[Z] = 2.490
  MASS[Z] = 91.187
  MASS[W] = 80.01626775931254
END_PARAMETERS

SELECTORS
END_SELECTORS

HISTOGRAMS
  y23  nbins = 100 min = 0.0 max = 1.0
  T    nbins = 40  min = 0.5 max = 1.0
END_HISTOGRAMS

SCALES
  mur = 1.0 * 50.0   muf = 1.0 * 50.0
END_SCALES

CHANNELS
  ! Contributions to compute (one or more per line):
  !   LO           Born
  !   R  V         NLO real and virtual corrections
  !   RR  RV  VV   NNLO double-real, real-virtual, double-virtual corrections
  ! (RRa/RRb restrict the double-real to one of its two phase-space regions)
  LO
END_CHANNELS
